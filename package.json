{
  "name": "echo-finders",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && vitest run --config test/api/vitest.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.api.json",
    "content:validate": "node scripts/validate-content.mjs",
    "content:status": "node scripts/content-status.mjs",
    "content:review": "node scripts/content-review.mjs",
    "library:build": "node scripts/build-library.mjs",
    "echo:render": "node scripts/render-echo.mjs",
    "audit:controls": "node scripts/audit-controls.mjs",
    "audit:contrast": "python3 scripts/check-contrast.py",
    "gate": "npm run typecheck && npm test && npm run content:validate && npm run build --workspace @echofinders/core && npm run library:build && npm run audit:contrast && npm run audit:frame && npm run audit:controls && npm run audit:spec && npm run audit:layout && npm run audit:paywall && npm run audit:align && npm run audit:flows",
    "audit:spec": "node scripts/check-spec.mjs",
    "audit:frame": "node scripts/check-frame.mjs",
    "audit:layout": "node scripts/audit-layout.mjs",
    "audit:paywall": "node scripts/audit-paywall.mjs",
    "audit:align": "node scripts/audit-align.mjs",
    "audit:flows": "node scripts/audit-flows.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "yaml": "^2.6.0"
  },
  "dependencies": {
    "@echofinders/core": "*"
  }
}
