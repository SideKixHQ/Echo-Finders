# What Expo's build servers get for the iPhone app (apps/ios): the app and the engine it
# imports, and the echo library, nothing else. Without this they get the whole repository, audio included (594 MB).
# Replaces .gitignore for EAS, so the usual exclusions are repeated here.
node_modules/
**/node_modules/
apps/ios/node_modules/
packages/core/node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.env
.env.*
/content/
/docs/
/design/
/scripts/
/test/
# The web app, except the one file the iPhone app imports: the generated echo library
# (apps/ios/src/library.ts). Its public/ holds the rendered audio, which the phone streams.
/apps/prototype/*
!/apps/prototype/src/
/apps/prototype/src/*
!/apps/prototype/src/library.generated.ts
/apps/site/
/packages/echo/
