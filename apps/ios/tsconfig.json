{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The generated library lives in the web app's source and imports the engine's types;
    // resolve them here, to this app's copy, rather than from the web app's node_modules.
    "paths": {
      "@echofinders/core": ["./node_modules/@echofinders/core"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
