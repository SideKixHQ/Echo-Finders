{
  "name": "@echofinders/ios",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "@echofinders/core": "file:../../packages/core"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform ios --output-dir dist",
    "eas-build-post-install": "npm --prefix ../../packages/core install --no-audit --no-fund && npm --prefix ../../packages/core run build"
  },
  "private": true
}
