{
  "expo": {
    "name": "Echo Finders",
    "slug": "echo-finders",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.echofinders.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Echo Finders uses the camera so you can hold up your phone and see which echoes are around you.",
        "WKAppBoundDomains": [
          "echo-finders.vercel.app"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "owner": "echofinders",
    "scheme": "echofinders",
    "extra": {
      "eas": {
        "projectId": "d1a83f71-a44c-4e52-ad76-446041fb41ae"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#010A52",
          "imageWidth": 200
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Echo Finders uses your location to find the echoes around you and to start each one as you reach it. Your exact location stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": "So echoes can start on their own as you reach them, with your phone in your pocket or the screen off, during a hands free walk or drive you start. Echo Finders works without this: keep it on screen and echoes will still open. Your exact location stays on your phone.",
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysPermission": "So echoes can start on their own as you reach them, with your phone in your pocket or the screen off, during a hands free walk or drive you start. Echo Finders works without this: keep it on screen and echoes will still open. Your exact location stays on your phone.",
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/withoutBackgroundFetch",
      "expo-iap"
    ]
  }
}
